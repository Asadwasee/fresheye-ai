# =========================================================
# FreshEye AI - Environment Configuration
# Copy this file to ".env" and fill in your real values.
# NEVER commit your real ".env" file to version control.
# =========================================================

# ---- Flask ----
FLASK_SECRET_KEY=change-this-to-a-long-random-string
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000

# ---- Database (auth + saved chat history) ----
# Defaults to a local SQLite file (fresheye.db) if unset - fine for an FYP
# / single-instance deployment. Point this at a Postgres URL instead if you
# ever need multiple app instances writing concurrently.
# DATABASE_URL=sqlite:///fresheye.db

# ---- LLM Provider ----
# "groq"   -> fast hosted inference of OPEN-SOURCE models (Llama 3.x, etc.) via Groq API (needs GROQ_API_KEY)
# "ollama" -> fully local, no API key needed, requires Ollama running locally (ollama serve)
LLM_PROVIDER=groq

# Groq API key (open-source Llama models served via Groq's free/low-cost API)
# Get one at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (used only when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ---- Embeddings (open-source, runs locally, no API key required) ----
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Vector store ----
CHROMA_PERSIST_DIR=chroma_db
CHROMA_COLLECTION_NAME=fruit_freshness_knowledge

# ---- YOLO classification model ----
YOLO_WEIGHTS_PATH=models/best.pt
YOLO_CONFIDENCE_THRESHOLD=0.35

# ---- Uploads ----
UPLOAD_FOLDER=static/uploads
MAX_CONTENT_LENGTH_MB=100
